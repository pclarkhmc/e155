`timescale 1 ns/1 ns

module lab01_tb();

  logic   [3:0]   s;      // 4-bit input switches
  logic           reset;  // active high reset
  logic			  enable; // clock enable
  logic   [2:0]   led;    // 2 output leds
  logic   [6:0]	  seg; 	  // 7-seg display

    lab01_pc dut (
        .reset(reset),
		.enable(enable),
        .s(s),
        .led(led),
		.seg(seg)
    );
	
  // apply stimuli and check outputs
  initial begin
	  
    //  test 1
	// test all inputs to led logic
	#10;
	s[1:0] = 2'b00;
	#10;
	assert (led[0] == s[0] ^ s[1]);
	s[1:0] = 2'b01;
	#10;
	assert (led[0] == s[0] ^ s[1]);
	s[1:0] = 2'b10;
	#10;
	assert (led[0] == s[0] ^ s[1]);
	s[1:0] = 2'b11;
	#10;
	assert (led[0] == s[0] ^ s[1]);

	#10;
	s[3:2] = 2'b00;
	#10;
	assert (led[1] == s[3] & s[2]);
	s[3:2] = 2'b01;
	#10;
	assert (led[1] == s[3] & s[2]);
	s[3:2] = 2'b10;
	#10;
	assert (led[1] == s[3] & s[2]);
	s[3:2] = 2'b11;
	#10;
	assert (led[1] == s[3] & s[2]);


	// show counter connects are correct
	enable = 0; // enable off
	#20;
	enable = 1;
	#20;
	enable = 0;
	#20
	reset = 1;
	#100;
	enable = 1;
	#100;
	enable = 0;
	#100;
	reset = 0; // reset on
	#100;
	reset = 1;
	#100;
	
    $stop;
  end
endmodule