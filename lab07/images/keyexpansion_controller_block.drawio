        <mxCell id="u_kl" value='Key Load Logic&lt;br&gt;&lt;span style="font-weight:normal;font-size:10px"&gt;in priority order (ready = key_ready):&lt;br&gt;1. reset: ready=0&lt;br&gt;2. round==0: key_out=key_in, ready=1&lt;br&gt;3. start: ready=0&lt;br&gt;4. done &amp;amp; !ready: key_out=new_key, ready=1&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;container=1;collapsible=0;fontStyle=1;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="T"><mxGeometry x="1160" y="57.5" width="360" height="380" as="geometry"/></mxCell>
